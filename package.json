{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:images && bash scripts/build-verified.sh",
    "build:vps": "npm run verify:security && npm run build:images && POETIO_RUNTIME=node vinext build && node scripts/verify-vps-assets.mjs",
    "start:vps": "node scripts/start-vps.mjs",
    "test:vps": "node --test --test-concurrency=1 tests/media-validator.test.mjs tests/poems.test.mjs tests/vps-storage.test.mjs tests/book-renderer.test.mjs tests/book-text.test.mjs tests/image-renderer.test.mjs tests/book-reading.test.mjs tests/editorial-migration.test.mjs tests/vps-assets.test.mjs tests/operations.test.mjs tests/poem-reading.test.mjs tests/draft-recovery.test.mjs tests/search-indexes.test.mjs tests/video-poster.test.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "verify:security": "node scripts/verify-security-runtime.mjs",
    "test:backup": "PYTHONDONTWRITEBYTECODE=1 python3 tests/backup-vps.test.py",
    "build:images": "node scripts/build-images.mjs",
    "test:operations": "node --test tests/operations.test.mjs tests/poem-reading.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 tests/operations-status.test.py && PYTHONDONTWRITEBYTECODE=1 python3 tests/notify-comments.test.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.8",
    "wrangler": "4.161.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@vercel/og": "1.0.3",
    "fflate": "0.7.5"
  }
}
