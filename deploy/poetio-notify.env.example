# Copy to /etc/poetio/notify.env (root:root, mode 0600) and fill in.
# Until this file exists, no email is sent.
#
# Gmail: create an "app password" in the Google account (Security → 2-Step
# Verification → App passwords) and use it below; the normal password is refused.
POETIO_SMTP_HOST=smtp.gmail.com
POETIO_SMTP_PORT=587
POETIO_SMTP_USER=adresa@gmail.com
POETIO_SMTP_PASSWORD=parola-de-aplicatie
# Where the notice is sent. The sender defaults to POETIO_SMTP_USER.
POETIO_NOTIFY_TO=adresa@gmail.com
# Optional: POETIO_NOTIFY_FROM, POETIO_SMTP_TLS (starttls or ssl), POETIO_SITE_URL.
