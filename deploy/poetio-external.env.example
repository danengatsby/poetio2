# Copy to /etc/poetio/external.env (root:root, mode 0600) and fill in.
# Until this file exists, poetio-offsite and poetio-heartbeat do nothing.

# --- Off-site copy (rclone) ---------------------------------------------------
# Destination: <remote>:<folder>. The units point rclone at
# /var/lib/poetio-offsite/rclone.conf, where the remote is defined.
#
# Google Drive, limited to the files rclone itself creates (scope drive.file):
#   sudo install -d -m 0700 /var/lib/poetio-offsite
#   sudo rclone config create poetio-offsite drive scope=drive.file \
#        --config /var/lib/poetio-offsite/rclone.conf
# then open the printed http://127.0.0.1:53682/ link from the VS Code terminal.
POETIO_OFFSITE_REMOTE=poetio-offsite:poetio-backups
# Keep the seven newest archives (about 3.6 GB) and delete older ones for good,
# not into the Drive trash, where they would still count against the quota.
POETIO_OFFSITE_KEEP=7
RCLONE_DRIVE_USE_TRASH=false

# S3-compatible storage instead (Backblaze B2, Cloudflare R2, AWS...): define the
# remote here and give its key list, read and write access without delete; then
# leave POETIO_OFFSITE_KEEP unset and expire old copies with a lifecycle rule.
#RCLONE_CONFIG_POETIO_OFFSITE_TYPE=s3
#RCLONE_CONFIG_POETIO_OFFSITE_PROVIDER=Other
#RCLONE_CONFIG_POETIO_OFFSITE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
#RCLONE_CONFIG_POETIO_OFFSITE_ACCESS_KEY_ID=keyID
#RCLONE_CONFIG_POETIO_OFFSITE_SECRET_ACCESS_KEY=applicationKey
#RCLONE_CONFIG_POETIO_OFFSITE_NO_CHECK_BUCKET=true

# --- External alerts (Healthchecks.io ping URLs) ------------------------------
# "Poetio backup": period 1 day, grace 3 hours.
POETIO_HEARTBEAT_BACKUP=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# "Poetio site": period 5 minutes, grace 10 minutes.
POETIO_HEARTBEAT_SITE=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Optional overrides.
#POETIO_SITE_URL=https://poetio.cloud
#POETIO_CERT_MIN_DAYS=14
#POETIO_BACKUP_MAX_AGE_HOURS=26
#POETIO_OFFSITE_MIN_FREE_GB=2
