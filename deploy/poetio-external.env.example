# Copy to /etc/poetio/external.env (root:root, mode 0600) and fill in.
# Until this file exists, poetio-offsite and poetio-heartbeat do nothing.

# --- Off-site copy (rclone) ---------------------------------------------------
# Destination: <remote>:<bucket>/<folder>. The remote "poetio-offsite" is defined
# by the RCLONE_CONFIG_POETIO_OFFSITE_* lines below; any rclone backend works.
POETIO_OFFSITE_REMOTE=poetio-offsite:poetio-backups/poetio

# Backblaze B2 through its S3 API (bucket in the region shown in the B2 console).
# Give the application key access to this bucket only, with listFiles, readFiles and
# writeFiles but without deleteFiles, so a key stolen from this server cannot erase
# the copies. Remove old copies with a lifecycle rule on the bucket instead.
RCLONE_CONFIG_POETIO_OFFSITE_TYPE=s3
RCLONE_CONFIG_POETIO_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_POETIO_OFFSITE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
RCLONE_CONFIG_POETIO_OFFSITE_ACCESS_KEY_ID=keyID
RCLONE_CONFIG_POETIO_OFFSITE_SECRET_ACCESS_KEY=applicationKey
RCLONE_CONFIG_POETIO_OFFSITE_NO_CHECK_BUCKET=true

# Optional: keep only this many archives at the destination (the key then needs
# delete permission). Unset, nothing is ever deleted there.
#POETIO_OFFSITE_KEEP=30

# --- External alerts (Healthchecks.io ping URLs) ------------------------------
# Daily check: period 1 day, grace 3 hours.
POETIO_HEARTBEAT_BACKUP=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# Site check: period 5 minutes, grace 10 minutes.
POETIO_HEARTBEAT_SITE=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Optional overrides.
#POETIO_SITE_URL=https://poetio.cloud
#POETIO_CERT_MIN_DAYS=14
#POETIO_BACKUP_MAX_AGE_HOURS=26
