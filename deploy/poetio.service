[Unit]
Description=Poetio poetry collection
After=network.target

[Service]
Type=simple
User=poetio
Group=poetio
WorkingDirectory=/var/www/Poetio/current
Environment=NODE_ENV=production
Environment=POETIO_DATA_DIR=/var/lib/poetio
Environment=POETIO_BUILD_DIR=/var/www/Poetio/current/dist
Environment=POETIO_PORT=4106
Environment=VINEXT_TRUSTED_HOSTS=poetio.cloud
# nginx serves authorized recordings and films (deploy/nginx-media-accel.conf).
Environment=POETIO_MEDIA_ACCEL=1
# runtime.env (root 0600) holds POETIO_OWNER_EMAIL, the administrator's address; without it
# administration stays closed (deploy/poetio-owner.conf.example has the matching nginx line).
EnvironmentFile=-/etc/poetio/runtime.env
ExecStart=/usr/local/bin/node /var/www/Poetio/current/scripts/start-vps.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=poetio
# 0750: nginx (group poetio) may traverse to audio/ and videos/; everything else stays private.
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/poetio
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=poetio

[Install]
WantedBy=multi-user.target
