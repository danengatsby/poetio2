[Unit]
Description=Poetio encrypted backup and isolated restore verification
After=local-fs.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
User=root
Group=root
# Seven verified archives stay here; older copies are kept off-site (poetio-offsite.timer).
ExecStart=/usr/bin/python3 /usr/local/sbin/poetio-backup create --keep 7
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/var/backups/poetio/automatic
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
